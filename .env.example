# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/viceatlas?schema=public"

# Better Auth: use a long random secret (32+ chars)
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Optional: custom MapLibre style URL. Default demo style works without a token.
NEXT_PUBLIC_MAP_STYLE_URL="https://demotiles.maplibre.org/style.json"

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Databuddy analytics
NEXT_PUBLIC_DATABUDDY_CLIENT_ID=""
