# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/viceatlas?schema=public"

# Better Auth: use a long random secret (32+ chars)
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
